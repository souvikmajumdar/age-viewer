{
  "name": "ag-viewer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup": "npm install && npm-run-all setup-front setup-backend",
    "setup-front": "cd frontend && npm install",
    "setup-backend": "cd backend && npm install",
    "front": "cd frontend && npm run start",
    "build-front": "cd frontend  && npm install && npm run build",
    "build-back": "cd backend  && npm install && npm run build",
    "backend": "cd backend && npm run start",
    "deploy": "npm-run-all build-front backend",
    "start": "npm-run-all --parallel backend front",
    "e2e": "./scripts/e2e-run.sh",
    "e2e:setup": "./scripts/e2e-setup-env.sh",
    "e2e:check": "./scripts/e2e-check-env.sh",
    "e2e:test": "./scripts/e2e-test.sh",
    "lint": "eslint backend/src frontend/src",
    "lint:fix": "eslint backend/src frontend/src --fix",
    "format": "prettier --write \"backend/src/**/*.js\" \"frontend/src/**/*.{js,jsx}\"",
    "format:check": "prettier --check \"backend/src/**/*.js\" \"frontend/src/**/*.{js,jsx}\""
  },
  "dependencies": {
    "npm-run-all2": "^7.0.2"
  },
  "license": "Apache-2.0",
  "licenses": [
    {
      "type": "Apache-2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0"
    }
  ],
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.60.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript-eslint": "8.59.3"
  }
}
